{
  "expo": {
    "name": "Ellie by MrFaivre",
    "slug": "ellie",
    "version": "2.0.0",
    "orientation": "portrait",
    "icon": "./assets/icony.png",
    "scheme": "ellie",
    "splash": {
      "image": "./assets/icony.png",
      "backgroundColor": "#1671B6",
      "resizeMode": "contain"
    },
    "ios": {
      "bundleIdentifier": "com.ellie.app",
      "supportsTablet": true,
      "infoPlist": {
        "CFBundleDisplayName": "Ellie - Learn English"
      }
    },
    "android": {
      "package": "com.ellie.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/icony.png",
        "backgroundColor": "#1671B6"
      }
    },
    "androidStatusBar": {
      "translucent": true,
      "backgroundColor": "#00000000",
      "barStyle": "light-content"
    },
    "updates": {
      "enabled": false
    },
    "web": {
      "name": "Ellie by MrFaivre",
      "shortName": "Ellie",
      "themeColor": "#1671B6",
      "backgroundColor": "#ffffff",
      "display": "standalone",
      "scope": "/",
      "startUrl": "/",
      "favicon": "./assets/icony.png"
    },
    "plugins": [
      "expo-asset",
      "expo-font",
      "expo-audio"
    ],
    "assetBundlePatterns": [
      "**/*"
    ],
    "extra": {
      "eas": {
        "projectId": "52c68ae6-5457-4bf8-897a-e9e76d521e63"
      }
    }
  }
}
