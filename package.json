{
  "name": "ellie-english",
  "version": "2.2.0",
  "license": "0BSD",
  "private": true,
  "main": "index.ts",
  "scripts": {
    "start": "npx expo start",
    "start:lan": "npx expo start --lan --port 8082",
    "start:tunnel": "npx expo start --tunnel --port 8082",
    "android": "npx expo run:android",
    "ios": "npx expo run:ios",
    "web": "npx expo start --web",
    "typecheck": "tsc --noEmit",
    "validate:content": "node scripts/validate-content.js",
    "validate:logic": "node scripts/validate-logic.js",
    "validate:build-config": "node scripts/validate-build-config.js",
    "check": "npm run typecheck && npm run validate:content && npm run validate:logic && npm run validate:build-config",
    "predeploy": "npx expo export --platform web",
    "deploy": "gh-pages -d dist"
  },
  "dependencies": {
    "@expo/metro-runtime": "~55.0.11",
    "@expo/vector-icons": "^15.0.0",
    "@react-native-async-storage/async-storage": "^2.2.0",
    "@react-native-community/slider": "^5.0.1",
    "@react-navigation/bottom-tabs": "7.4.6",
    "@react-navigation/native": "^7.2.2",
    "@react-navigation/native-stack": "7.3.25",
    "@supabase/supabase-js": "2.56.0",
    "expo": "~55.0.26",
    "expo-asset": "~55.0.17",
    "expo-audio": "^55.0.0",
    "expo-blur": "^55.0.0",
    "expo-font": "~55.0.8",
    "expo-haptics": "^55.0.0",
    "expo-linear-gradient": "~55.0.14",
    "expo-status-bar": "~55.0.6",
    "lucide-react-native": "0.542.0",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-native": "0.83.6",
    "react-native-gesture-handler": "^2.29.0",
    "react-native-keyboard-aware-scroll-view": "^0.9.5",
    "react-native-reanimated": "^4.2.0",
    "react-native-safe-area-context": "^5.6.0",
    "react-native-screens": "^4.18.0",
    "react-native-svg": "^15.15.0",
    "react-native-web": "^0.21.0",
    "react-native-worklets": "^0.7.0",
    "sonner-native": "0.21.1"
  },
  "devDependencies": {
    "@babel/core": "^7.20.0",
    "@types/react": "^19.2.14",
    "babel-preset-expo": "^55.0.22",
    "gh-pages": "^6.3.0",
    "supabase": "^2.39.2",
    "typescript": "^5.1.3"
  }
