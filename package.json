{
  "name": "ellie-english",
  "version": "3.0.0",
  "license": "0BSD",
  "private": true,
  "main": "index.ts",
  "scripts": {
    "start": "npx expo start",
    "start:lan": "npx expo start --lan --port 8082",
    "start:tunnel": "npx expo start --tunnel --port 8082",
    "android": "npx expo run:android",
    "ios": "npx expo run:ios",
    "web": "npx expo start --web",
    "typecheck": "tsc --noEmit",
    "validate:content": "node scripts/validate-content.js",
    "validate:logic": "node scripts/validate-logic.js",
    "validate:build-config": "node scripts/validate-build-config.js",
    "check": "npm run typecheck && npm run validate:content && npm run validate:logic && npm run validate:build-config && npm test -- --ci",
    "test": "jest",
    "build:web": "npx expo export --platform web && node scripts/fix-web-base-path.js",
    "predeploy": "npm run build:web",
    "deploy": "gh-pages -d dist",
    "ota": "node scripts/mark-lesson-changes.js && npx eas-cli update --channel preview --environment preview --non-interactive",
    "ota:check": "node scripts/mark-lesson-changes.js --check"
  },
  "overrides": {
    "shell-quote": "^1.8.4",
    "uuid": "^11.1.1"
  },
  "dependencies": {
    "@expo-google-fonts/libre-franklin": "^0.4.2",
    "@expo-google-fonts/press-start-2p": "^0.4.1",
    "@expo/metro-runtime": "~57.0.13",
    "@expo/vector-icons": "^15.0.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-navigation/bottom-tabs": "7.4.6",
    "@react-navigation/native": "^7.2.2",
    "@react-navigation/native-stack": "7.3.25",
    "@supabase/supabase-js": "2.56.0",
    "expo": "~57.0.21",
    "expo-asset": "~57.0.10",
    "expo-audio": "~57.0.4",
    "expo-build-properties": "~57.0.17",
    "expo-font": "~57.0.1",
    "expo-haptics": "~57.0.2",
    "expo-image": "~57.0.4",
    "expo-linear-gradient": "~57.0.1",
    "expo-speech": "~57.0.2",
    "expo-status-bar": "~57.0.1",
    "expo-updates": "~57.0.21",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-web": "^0.21.2",
    "react-native-worklets": "0.10.1",
    "sonner-native": "0.21.1"
  },
  "devDependencies": {
    "@babel/core": "^7.20.0",
    "@testing-library/react-native": "^13.3.3",
    "@types/jest": "29.5.14",
    "@types/react": "^19.2.14",
    "babel-preset-expo": "~57.0.0",
    "gh-pages": "^6.3.0",
    "jest-expo": "~57.0.5",
    "react-refresh": "^0.14.2",
    "react-test-renderer": "^19.2.3",
    "supabase": "^2.39.2",
    "typescript": "~6.0.3"
  }
}
